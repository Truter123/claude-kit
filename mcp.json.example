{
  "mcpServers": {
    "code-navigator": {
      "command": "java",
      "args": [
        "-jar",
        "${CODE_NAVIGATOR_JAR:-${HOME}/Documents/Tools/code-navigator/jars/code-navigator.jar}",
        "serve"
      ],
      "env": {
        "CODE_NAVIGATOR_PROJECT": "${CLAUDE_PROJECT_DIR}"
      }
    }
  }
}
